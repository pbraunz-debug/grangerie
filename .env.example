# ---- Sanity -----------------------------------------------------------------
# The site renders with built-in fallback copy when these are unset, so you can
# run `npm run dev` before the Studio exists.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Viewer token — server-only. Required for draft/live preview and the seed script
# (the seed script needs write access, so use an Editor token there).
SANITY_API_READ_TOKEN=
# Shared secret checked by /api/revalidate against the Sanity webhook signature.
SANITY_REVALIDATE_SECRET=

# ---- Shopify (Storefront API) ----------------------------------------------
# Without these the cart falls back to a local, non-checkout demo cart.
SHOPIFY_STORE_DOMAIN=grangerie.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-01
SHOPIFY_ADMIN_API_TOKEN=
# Variant id of "Nap Socks — Oatmeal, One Size" ($0). The Shopify Function is the
# source of truth at checkout; this is the drawer's display fallback.
SHOPIFY_NAP_SOCKS_VARIANT_ID=

# ---- Newsletter -------------------------------------------------------------
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://grangerie.com
